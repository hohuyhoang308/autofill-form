{
    "manifest_version": 3,
    "name": "Khảo Sát Học Phần",
    "version": "1.0",
    "description": "Tự động đánh giá khảo sát với menu chỉnh sửa, hỗ trợ radio button và listbox",
    "author": "Hồ Huy Hoàng",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon16.png",
        "128": "icons/icon16.png"
    },
    "content_scripts": [
        {
            "matches": ["https://forms.office.com/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "permissions": [
        "storage",
        "activeTab"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon16.png",
            "128": "icons/icon16.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}